{
  "name": "screening",
  "version": "0.6.0",
  "description": "Interview answers at your MacBook notch, right under your camera. Local Whisper, ChatGPT answers, hidden from screen sharing.",
  "main": "src/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:native": "node scripts/build-native.cjs",
    "verify": "electron . --verify",
    "verify:capture": "electron . --verify --capture-test",
    "package:mac": "npm run build:native && node scripts/prepare-runtime.cjs && electron-builder --mac dmg --arm64 --publish never",
    "test": "node --test test/unit.test.cjs test/buddy.test.cjs",
    "package:win": "node scripts/prepare-runtime.cjs && electron-builder --win nsis --x64 --publish never",
    "verify:interview": "electron . --verify --interview-test",
    "verify:audio": "electron . --verify --interview-test --audio-test"
  },
  "devDependencies": {
    "electron": "40.10.6",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@openai/codex": "0.163.0",
    "onnxruntime-node": "1.30.0"
  },
  "author": "Dimash Arystambek",
  "license": "MIT",
  "build": {
    "appId": "local.capturelab.prototype",
    "productName": "Screening",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/@openai/**/*",
      "LICENSE",
      "assets/models/**/*",
      "assets/licenses/**/*",
      "assets/brand/**/*",
      "assets/tray/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/*.dylib",
      "**/*.dll",
      "**/onnxruntime-node/**"
    ],
    "extraResources": [
      {
        "from": "build/codex",
        "to": "codex",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "entitlements": "scripts/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Screening transcribes your microphone on this computer while you listen.",
        "NSAudioCaptureUsageDescription": "Screening transcribes the call audio you choose, on this computer.",
        "NSScreenCaptureUsageDescription": "Screening snapshots a window only when you ask, and uses screen access for call audio and the screen sharing test.",
        "LSUIElement": true
      },
      "extraResources": [
        {
          "from": "bin",
          "to": "bin",
          "filter": [
            "capture-sck",
            "capture-legacy",
            "audio-sck",
            "notch-info"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "Screening-${version}-${os}-${arch}.${ext}",
    "afterPack": "scripts/after-pack.cjs"
  }
}
